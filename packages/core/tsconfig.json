{
  "extends": "@workspace/typescript-config/node.json",
  "compilerOptions": {
    // No `rootDir`: this package never emits (the `exports` map points straight at
    // `src/*.ts`), and pinning it to `.` made `include: ["."]` a TS6059 error on
    // `vitest.msw.ts` — which `@test/msw` resolves to from test files.
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": "../..",
    "paths": {
      "*": ["./*"],
      "@test/msw": ["../../vitest.msw.ts"],
      "@workspace/core/*": ["./src/*"]
    },
    "strictNullChecks": true
  },
  "include": [".", "../../vitest.msw.ts"],
  "exclude": ["node_modules", "dist"]
}
