{
  "name": "@workspace/core",
  "version": "1.0.0",
  "private": true,
  "description": "Shared core module for monorepo",
  "license": "MIT",
  "author": "Tri Rizeki Rifandani",
  "type": "module",
  "exports": {
    "./apis/*": "./src/apis/*.ts",
    "./assets/*": "./src/assets/*",
    "./constants/*": "./src/constants/*.ts",
    "./services/*": "./src/services/*.ts",
    "./types/*": "./src/types/*.ts",
    "./utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "dependencies": {
    "ky": "2.0.2",
    "radashi": "12.9.1",
    "type-fest": "5.8.0",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
