{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "src/app/{index,main,node,bun}.{ts,tsx,js,jsx}",
    "packages/load/src/app/run.ts",
    "packages/load/src/features/*/index.ts"
  ],
  "workspaces": {
    "patterns": ["apps/*", "packages/*"]
  },
  "ignorePatterns": ["repos/**"],
  "overrides": [
    {
      "files": [
        "oxfmt.config.ts",
        "stryker.config.mjs",
        "apps/hono/src/server/middleware/rate-limit/*.ts",
        "scripts/security/sarif-severity-gate.ts"
      ],
      "rules": {
        "unused-files": "off"
      }
    }
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "health": {
    "ignore": [
      "oxlint.config.ts",
      "**/*.{test,spec}.{ts,tsx}",
      "scripts/security/**"
    ]
  },
  "ignoreDependencies": [
    "@stryker-mutator/core",
    "@stryker-mutator/vitest-runner",
    "@opentelemetry/semantic-conventions",
    "msw"
  ]
}
