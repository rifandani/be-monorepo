{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": ["src/index.{ts,tsx,js,jsx}", "src/main.{ts,tsx,js,jsx}"],
  "workspaces": {
    "patterns": ["apps/*", "packages/*"]
  },
  "overrides": [
    {
      "files": ["oxfmt.config.ts"],
      "rules": {
        "unused-files": "off"
      }
    }
  ],
  "duplicates": {
    "minOccurrences": 3
  },
  "health": {
    "ignore": ["oxlint.config.ts", "**/*.{test,spec}.{ts,tsx}"]
  },
  "ignoreDependencies": ["@opentelemetry/semantic-conventions"]
}
