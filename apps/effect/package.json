{
  "name": "@workspace/effect",
  "version": "1.1.1",
  "private": true,
  "description": "Effect v4 HTTP API template",
  "license": "MIT",
  "author": "Tri Rizeki Rifandani",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "typerange": "fr",
    "test": "vitest",
    "dev:server": "bun run --env-file=.env.dev --hot src/bun.ts",
    "dev": "portless run --name effect.be-monorepo --script dev:server",
    "node:dev:server": "dotenvx run --env-file=.env.dev -- node --watch src/node.ts",
    "node:dev": "portless run --name effect.be-monorepo --script node:dev:server",
    "node:start": "dotenvx run --env-file=.env.dev -- node ./src/node.ts"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.38.2",
    "@effect/opentelemetry": "4.1.2",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.223.0",
    "@opentelemetry/sdk-logs": "0.223.0",
    "@opentelemetry/sdk-metrics": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.5",
    "@effect/vitest": "4.1.2",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@workspace/typescript-config": "workspace:*",
    "portless": "0.15.13",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
