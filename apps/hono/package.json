{
  "name": "@workspace/hono",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Bulletproof Hono 4 template",
  "author": "Tri Rizeki Rifandani",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ngrok": "ngrok http --url=freely-equal-shepherd.ngrok-free.app 3333",
    "db:pull": "dotenvx run --env-file=.env.dev -- drizzle-kit pull",
    "db:push": "dotenvx run --env-file=.env.dev -- drizzle-kit push --verbose --strict",
    "db:gen": "dotenvx run --env-file=.env.dev -- drizzle-kit generate",
    "db:migrate": "dotenvx run --env-file=.env.dev -- drizzle-kit migrate",
    "db:studio": "dotenvx run --env-file=.env.dev -- drizzle-kit studio --port 3003 --verbose",
    "auth:gen": "dotenvx run --env-file=.env.dev -- bunx @better-auth/cli generate --config ./src/auth/libs/index.ts --output ./src/db/auth-schema.ts --yes",
    "test": "bun test --env-file=.env.dev",
    "dev": "bun run --env-file=.env.dev --hot --preload src/instrumentation.ts src/bun.ts",
    "dev:prod": "bun run --env-file=.env.prod --hot --preload src/instrumentation.ts src/bun.ts",
    "node:dev": "dotenvx run --env-file=.env.dev -- tsx watch --import src/instrumentation.ts src/node.ts",
    "node:dev:prod": "dotenvx run --env-file=.env.prod -- tsx watch --import src/instrumentation.ts src/node.ts",
    "node:build": "dotenvx run --env-file=.env.dev -- tsc -p .",
    "node:build:prod": "dotenvx run --env-file=.env.prod -- tsc -p .",
    "node:start": "dotenvx run --env-file=.env.dev -- node ./dist/node.js",
    "node:start:prod": "dotenvx run --env-file=.env.prod -- node ./dist/node.js"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.52.0",
    "@hono/node-server": "1.19.9",
    "@hono/otel": "1.1.0",
    "@hono/zod-openapi": "1.2.2",
    "@hono/zod-validator": "0.7.6",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/api-logs": "0.212.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.212.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.212.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.212.0",
    "@opentelemetry/instrumentation-dns": "0.55.0",
    "@opentelemetry/instrumentation-http": "0.212.0",
    "@opentelemetry/instrumentation-net": "0.56.0",
    "@opentelemetry/instrumentation-pg": "0.64.0",
    "@opentelemetry/instrumentation-runtime-node": "0.25.0",
    "@opentelemetry/instrumentation-undici": "0.22.0",
    "@opentelemetry/resources": "2.5.1",
    "@opentelemetry/sdk-logs": "0.212.0",
    "@opentelemetry/sdk-metrics": "2.5.1",
    "@opentelemetry/sdk-node": "0.212.0",
    "@opentelemetry/sdk-trace-node": "2.5.1",
    "@opentelemetry/semantic-conventions": "1.39.0",
    "@scalar/hono-api-reference": "0.9.41",
    "@scalar/openapi-to-markdown": "0.3.45",
    "@t3-oss/env-core": "0.13.10",
    "@workspace/core": "workspace:*",
    "better-auth": "1.4.18",
    "drizzle-orm": "0.45.1",
    "drizzle-seed": "0.3.1",
    "drizzle-zod": "0.8.3",
    "hono": "4.11.9",
    "hono-rate-limiter": "0.5.3",
    "ky": "1.14.3",
    "pg": "8.18.0",
    "radashi": "12.7.1",
    "ts-pattern": "5.9.0",
    "type-fest": "5.4.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bun": "1.3.9",
    "@types/node": "25.2.3",
    "@types/pg": "8.16.0",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.9",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  }
}
