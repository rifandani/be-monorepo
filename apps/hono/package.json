{
  "name": "@workspace/hono",
  "version": "1.1.1",
  "private": true,
  "description": "Bulletproof Hono 4 template",
  "license": "MIT",
  "author": "Tri Rizeki Rifandani",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "typerange": "fr",
    "db:pull": "dotenvx run --env-file=.env.dev -- drizzle-kit pull",
    "db:push": "dotenvx run --env-file=.env.dev -- drizzle-kit push --verbose --strict",
    "db:gen": "dotenvx run --env-file=.env.dev -- drizzle-kit generate",
    "db:migrate": "dotenvx run --env-file=.env.dev -- drizzle-kit migrate",
    "db:seed": "dotenvx run --env-file=.env.dev -- bun ./src/db/seeds/seed-user.ts",
    "db:studio": "dotenvx run --env-file=.env.dev -- drizzle-kit studio --port 3334 --verbose",
    "auth:gen": "dotenvx run --env-file=.env.dev -- bunx @better-auth/cli@latest generate --config ./src/auth/utils/index.ts --output ./src/db/auth-schema.ts --yes",
    "test": "vitest",
    "dev:server": "bun run --env-file=.env.dev --hot --preload ./src/instrumentation.ts src/bun.ts",
    "dev": "portless run --name hono.be-monorepo --script dev:server",
    "node:dev:server": "dotenvx run --env-file=.env.dev -- node --watch --import ./src/instrumentation.ts src/node.ts",
    "node:dev": "portless run --name hono.be-monorepo --script node:dev:server",
    "node:start": "dotenvx run --env-file=.env.dev -- node ./src/node.ts"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "2.38.2",
    "@hono/node-server": "2.1.6",
    "@hono/otel": "1.3.0",
    "@hono/zod-openapi": "1.6.3",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.300.0",
    "@opentelemetry/instrumentation-pg": "0.77.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "3.0.0",
    "@opentelemetry/sdk-node": "0.300.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "@scalar/hono-api-reference": "0.12.17",
    "@scalar/openapi-to-markdown": "1.7.3",
    "@t3-oss/env-core": "0.13.11",
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "drizzle-seed": "0.3.1",
    "drizzle-zod": "0.8.3",
    "evlog": "2.34.0",
    "hono": "4.13.16",
    "hono-rate-limiter": "0.5.4",
    "ky": "2.2.0",
    "pg": "8.23.1",
    "radashi": "13.0.1",
    "ts-pattern": "5.9.2",
    "type-fest": "5.10.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.11",
    "portless": "0.15.13",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
