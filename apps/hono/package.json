{
  "name": "@workspace/hono",
  "version": "1.0.0",
  "private": true,
  "description": "Bulletproof Hono 4 template",
  "license": "MIT",
  "author": "Tri Rizeki Rifandani",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:pull": "dotenvx run --env-file=.env.dev -- drizzle-kit pull",
    "db:push": "dotenvx run --env-file=.env.dev -- drizzle-kit push --verbose --strict",
    "db:gen": "dotenvx run --env-file=.env.dev -- drizzle-kit generate",
    "db:migrate": "dotenvx run --env-file=.env.dev -- drizzle-kit migrate",
    "db:studio": "dotenvx run --env-file=.env.dev -- drizzle-kit studio --port 3334 --verbose",
    "auth:gen": "dotenvx run --env-file=.env.dev -- bunx @better-auth/cli@latest generate --config ./src/auth/utils/index.ts --output ./src/db/auth-schema.ts --yes",
    "test": "dotenvx run --env-file=.env.dev -- vitest",
    "test:ci": "dotenvx run --env-file=.env.dev -- vitest run --shard=$SHARD_INDEX/$SHARD_TOTAL",
    "dev": "bun run --env-file=.env.dev --hot --preload src/instrumentation.ts src/bun.ts",
    "dev:prod": "bun run --env-file=.env.prod --hot --preload src/instrumentation.ts src/bun.ts",
    "node:dev": "dotenvx run --env-file=.env.dev -- tsx watch --import src/instrumentation.ts src/node.ts",
    "node:dev:prod": "dotenvx run --env-file=.env.prod -- tsx watch --import src/instrumentation.ts src/node.ts",
    "node:build": "dotenvx run --env-file=.env.dev -- tsc -p .",
    "node:build:prod": "dotenvx run --env-file=.env.prod -- tsc -p .",
    "node:start": "dotenvx run --env-file=.env.dev -- node ./dist/node.js",
    "node:start:prod": "dotenvx run --env-file=.env.prod -- node ./dist/node.js"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.66.0",
    "@hono/node-server": "2.0.3",
    "@hono/otel": "1.1.2",
    "@hono/zod-openapi": "1.4.0",
    "@hono/zod-validator": "0.8.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.218.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.218.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.218.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.218.0",
    "@opentelemetry/instrumentation-dns": "0.61.0",
    "@opentelemetry/instrumentation-http": "0.218.0",
    "@opentelemetry/instrumentation-net": "0.62.0",
    "@opentelemetry/instrumentation-pg": "0.70.0",
    "@opentelemetry/instrumentation-runtime-node": "0.31.0",
    "@opentelemetry/instrumentation-undici": "0.28.0",
    "@opentelemetry/resources": "2.7.1",
    "@opentelemetry/sdk-logs": "0.218.0",
    "@opentelemetry/sdk-metrics": "2.7.1",
    "@opentelemetry/sdk-node": "0.218.0",
    "@opentelemetry/sdk-trace-node": "2.7.1",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "@scalar/hono-api-reference": "0.10.16",
    "@scalar/openapi-to-markdown": "0.5.17",
    "@t3-oss/env-core": "0.13.11",
    "@workspace/core": "workspace:*",
    "better-auth": "1.6.11",
    "drizzle-orm": "0.45.2",
    "drizzle-seed": "0.3.1",
    "drizzle-zod": "0.8.3",
    "hono": "4.12.19",
    "hono-rate-limiter": "0.5.3",
    "ky": "2.0.2",
    "pg": "8.21.0",
    "radashi": "12.9.1",
    "ts-pattern": "5.9.0",
    "type-fest": "5.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "25.9.1",
    "@types/pg": "8.20.0",
    "@workspace/typescript-config": "workspace:*",
    "drizzle-kit": "0.31.10",
    "tsx": "4.22.2",
    "typescript": "6.0.3",
    "vitest": "4.1.7"
  }
}
