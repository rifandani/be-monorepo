{
  "name": "be-monorepo",
  "version": "1.1.1",
  "private": true,
  "description": "Hono, and Effect Monorepo Template",
  "license": "MIT",
  "author": "Tri Rizeki Rifandani",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "compose:up": "docker compose -f ./docker/docker-compose.yml up --build",
    "clean": "rimraf --glob \"**/node_modules\" \"**/dev-dist\" \"**/dist\" \"**/dev-build\" \"**/build\" \"**/bun.lock\" && bun pm cache rm && bun install",
    "repos:update": "bun scripts/update-vendored-repos.ts",
    "bump:deps": "bunx npm-check-updates --workspaces -u --peer --dep prod,dev,optional,packageManager,peer -x @babel*,tamagui",
    "portless": "portless proxy start --https",
    "cs": "changeset",
    "cs:v": "changeset version",
    "lint": "ultracite check --disable-nested-config",
    "lint:fix": "ultracite fix --disable-nested-config",
    "lint:doctor": "ultracite doctor",
    "check:health": "fallow health --top 10 --quiet",
    "check:dead-code": "fallow dead-code --quiet",
    "check:dupes": "fallow dupes --mode semantic --quiet",
    "check:security": "fallow security --surface --quiet",
    "check:security:survivors": "fallow security --format json --quiet -o node_modules/.cache/fallow-security.json && fallow security survivors --candidates node_modules/.cache/fallow-security.json --verdicts .fallow/security-verdicts.json --require-verdict-for-each-candidate",
    "audit:sca": "node scripts/security/sca-gate.ts",
    "zap:hono:baseline": "bun scripts/security/zap.ts hono-baseline",
    "zap:hono:active": "bun scripts/security/zap.ts hono-active",
    "zap:effect:baseline": "bun scripts/security/zap.ts effect-baseline",
    "zap:effect:active": "bun scripts/security/zap.ts effect-active",
    "load:hono:smoke": "bun packages/load/src/run.ts hono smoke",
    "load:hono:load": "bun packages/load/src/run.ts hono load",
    "load:hono:stress": "bun packages/load/src/run.ts hono stress",
    "load:hono:spike": "bun packages/load/src/run.ts hono spike",
    "load:hono:breakpoint": "bun packages/load/src/run.ts hono breakpoint",
    "load:effect:smoke": "bun packages/load/src/run.ts effect smoke",
    "load:effect:load": "bun packages/load/src/run.ts effect load",
    "load:effect:stress": "bun packages/load/src/run.ts effect stress",
    "load:effect:spike": "bun packages/load/src/run.ts effect spike",
    "load:effect:breakpoint": "bun packages/load/src/run.ts effect breakpoint",
    "check:all": "fallow --quiet",
    "check:viz": "fallow viz --out .fallow/map.html",
    "check:fix": "fallow fix --yes --no-create-config",
    "test": "vitest",
    "test:cov": "vitest run --coverage",
    "test:mutate": "stryker run",
    "test:mutate:inc": "stryker run --incremental",
    "typerange": "bun run --parallel hono:typerange effect:typerange",
    "hono": "bun --elide-lines=0 --filter @workspace/hono",
    "hono:typerange": "bun hono typerange",
    "hono:test": "bun hono test",
    "effect": "bun --elide-lines=0 --filter @workspace/effect",
    "effect:typerange": "bun effect typerange",
    "effect:test": "bun effect test",
    "load": "bun --elide-lines=0 --filter @workspace/load"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@chenglou/freerange": "0.0.5",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.0.5",
    "@workspace/typescript-config": "workspace:*",
    "fallow": "3.38.1",
    "husky": "9.1.7",
    "msw": "3.0.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "ultracite": "8.1.1",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "undici": "8.12.3"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "vue-demi"
  ]
}
