{
  "name": "be-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Hono Monorepo Template",
  "author": "Tri Rizeki Rifandani",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "compose:up": "docker compose -f ./docker/docker-compose.yml up --build",
    "clean": "rimraf --glob \"**/node_modules\" \"**/dev-dist\" \"**/dist\" \"**/dev-build\" \"**/build\" \"**/bun.lock\" && bun pm cache rm && bun install",
    "bump:deps": "bunx npm-check-updates --deep -u --peer --dep prod,dev,optional,packageManager,peer -x @babel*,tamagui",
    "cs": "changeset",
    "cs:v": "changeset version",
    "lint": "ultracite check",
    "lint:fix": "ultracite fix",
    "lint:doctor": "ultracite doctor",
    "check:health": "fallow health --css --top 10 --quiet",
    "check:dead-code": "fallow dead-code --quiet",
    "check:dupes": "fallow dupes --mode semantic --quiet",
    "check:security": "fallow security --surface  --quiet",
    "check:flags": "fallow flags --quiet",
    "check:coverage": "fallow coverage analyze --runtime-coverage ./coverage --quiet",
    "check:audit": "fallow audit --quiet",
    "check:fix": "fallow fix --yes --no-create-config",
    "test": "vitest",
    "test:ci": "vitest run --shard=$SHARD_INDEX/$SHARD_TOTAL",
    "typecheck": "bun run --parallel hono:typecheck core:typecheck",
    "lint-typecheck": "bun run --parallel lint hono:typecheck core:typecheck",
    "hono": "bun --elide-lines=0 --filter @workspace/hono",
    "hono:typecheck": "bun hono typecheck",
    "hono:test": "bun hono test",
    "core": "bun --elide-lines=0 --filter @workspace/core",
    "core:typecheck": "bun core typecheck"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.1",
    "@types/node": "26.1.1",
    "@workspace/typescript-config": "workspace:*",
    "fallow": "3.10.0",
    "husky": "9.1.7",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "rimraf": "6.1.3",
    "typescript": "7.0.2",
    "ultracite": "7.9.4",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "esbuild",
    "protobufjs",
    "vue-demi"
  ]
}
